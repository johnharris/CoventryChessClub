# The SQLite database is data, not code — never commit it.
/database/*.sqlite
/database/*.sqlite-journal

# NOTE: /public/build is deliberately NOT ignored.
# The compiled CSS and JavaScript are committed so the site can be deployed to
# hosting that has no Node.js — which is most cheap shared hosting. Run
# `pnpm run build` and commit the result whenever you change anything in
# resources/css or resources/js.
