APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Coventry Chess Club
# ---------------------------------------------------------------------------
# Club identity and venue. These appear in the header, footer, contact page
# and page metadata, so they can be changed without editing any template.
CLUB_NAME="Coventry Chess Club"
CLUB_TAGLINE="Chess in Coventry every Tuesday evening — all standards welcome."
CLUB_MEETING_DAY=Tuesday
CLUB_MEETING_TIME="7:30pm"
CLUB_JUNIORS_TIME="6:00pm – 7:15pm"
CLUB_VENUE_NAME="Massey Ferguson Social Club"
CLUB_VENUE_ADDRESS="Broad Lane, Coventry"
CLUB_VENUE_POSTCODE="CV5 7NL"
CLUB_VENUE_WEBSITE=
CLUB_VENUE_MAP_URL=

# Where contact form enquiries are emailed. Leave blank to store them on the
# site only — enquiries are always stored in the database regardless.
CLUB_ENQUIRY_EMAIL=

# External links shown in the footer and on the Useful Links page.
CLUB_LINK_COVENTRY_LEAGUE=http://covchessleague.blogspot.com/
CLUB_LINK_COVENTRY_RESULTS=
CLUB_LINK_LEAMINGTON_LEAGUE=http://www.leamingtonchessleague.org.uk/
CLUB_LINK_ECF=https://www.englishchess.org.uk/
CLUB_LINK_LICHESS=https://lichess.org/
CLUB_LINK_FACEBOOK=

# ---------------------------------------------------------------------------
# The first administrator, created by `php artisan db:seed`
# ---------------------------------------------------------------------------
# Registration is gated on the whitelist and only an administrator can add to
# the whitelist, so the very first account has to be seeded. Set a real email
# and a strong password before seeding a live site.
ADMIN_NAME="Club Administrator"
ADMIN_DISPLAY_NAME=
ADMIN_EMAIL=admin@coventrychessclub.test
ADMIN_PASSWORD=password

# An example club member, useful in development. Remove for a live site.
MEMBER_NAME="Club Member"
MEMBER_EMAIL=member@coventrychessclub.test
MEMBER_PASSWORD=password
