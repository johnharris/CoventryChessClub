APP_NAME="Coventry Chess Club"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@coventrychessclub.co.uk"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Coventry Chess Club
# ---------------------------------------------------------------------------
# Club identity and venue. These appear in the header, footer, contact page
# and page metadata, so they can be changed without editing any template.
CLUB_NAME="Coventry Chess Club"
CLUB_TAGLINE="Chess in Coventry every Tuesday evening — all standards welcome."
CLUB_MEETING_DAY=Tuesday
CLUB_MEETING_TIME="7:30pm"
CLUB_JUNIORS_TIME="Tuesday, 4:30pm"

# The junior section meets at a DIFFERENT venue from the main club night, and
# places must be pre-booked.
CLUB_JUNIORS_VENUE_NAME="St Oswald's Church Hall"
CLUB_JUNIORS_VENUE_ADDRESS="Tile Hill, Coventry"
CLUB_JUNIORS_VENUE_MAP_URL=
CLUB_JUNIORS_BOOKING_REQUIRED=true
CLUB_JUNIORS_FEE="£5 per session"

# Postal address is Banner Lane; the entrance visitors use is on Broad Lane.
# Both are shown on the site so nobody arrives at the wrong door.
CLUB_VENUE_NAME="Massey Ferguson Social Club"
CLUB_VENUE_ADDRESS="Banner Lane, Coventry"
CLUB_VENUE_POSTCODE="CV5 7NL"
CLUB_VENUE_ENTRANCE="Entrance on Broad Lane"
CLUB_VENUE_WEBSITE=
CLUB_VENUE_MAP_URL=

# Club officers. These appear on the contact page and in the automatic reply
# sent to anyone who uses the contact form.
CLUB_CHAIRMAN_NAME="Dave Filer"
CLUB_CHAIRMAN_ROLE="Chairman"
CLUB_CHAIRMAN_PHONE="024 7641 1719"
CLUB_SECRETARY_NAME="Simon Weaver"
CLUB_SECRETARY_ROLE="Club Secretary"
CLUB_SECRETARY_PHONE="01455 221297"

# Automatic acknowledgement sent to anyone who submits the contact form.
# Set CLUB_AUTO_REPLY_ENABLED=false to switch it off without removing anything.
CLUB_AUTO_REPLY_ENABLED=true
CLUB_AUTO_REPLY_SUBJECT="Thank you for your interest in Coventry Chess Club"
CLUB_AUTO_REPLY_SIGNATURE="Simon Weaver"
CLUB_AUTO_REPLY_SIGNATURE_ROLE="Club Secretary"

# Teams and coaching, used in the automatic reply and on the Teams page.
CLUB_COVENTRY_TEAM_COUNT=six
# Set to true to mention the club's 4NCL side in the automatic reply.
CLUB_PLAYS_4NCL=false
CLUB_COACHING_TRAINERS="two fully qualified trainers"
CLUB_COACHING_PAID=true

# Where contact form enquiries are emailed. Separate multiple addresses with
# commas. Each recipient receives a private copy; enquiries are also stored in
# the administrator inbox regardless of mail delivery.
CLUB_ENQUIRY_EMAILS=simonw21@yahoo.com,david_filer@hotmail.com

# External links shown in the footer and on the Useful Links page.
CLUB_LINK_COVENTRY_LEAGUE=http://covchessleague.blogspot.com/
CLUB_LINK_COVENTRY_RESULTS=
CLUB_LINK_LEAMINGTON_LEAGUE=http://www.leamingtonchessleague.org.uk/
CLUB_LINK_4NCL=https://www.4ncl.co.uk/
CLUB_LINK_ECF=https://www.englishchess.org.uk/
CLUB_LINK_LICHESS=https://lichess.org/
CLUB_LINK_FACEBOOK=https://www.facebook.com/groups/coventrychessclub

# Courtesy credit to whoever hosts the site, shown in the footer. Krystal's
# not-for-profit scheme asks for one in return for free hosting. Set the name
# blank to remove the credit altogether.
CLUB_HOST_NAME=Krystal
CLUB_HOST_URL=https://krystal.io/
CLUB_HOST_PREFIX="Hosted by"

# ---------------------------------------------------------------------------
# The club's administrators, created by `php artisan db:seed`
# ---------------------------------------------------------------------------
# Registration is gated on the whitelist and only an administrator can add to
# the whitelist, so these three accounts have to be seeded. Everybody after them
# is invited from the Members screen in the normal way.
#
# IMPORTANT: set a different, strong password for each of these before seeding a
# live site. Each account can manage members, every post and all the club pages.
# Leaving them as "password" on a public site would hand the site to anyone who
# reads this file in the repository.

SIMON_NAME="Simon Weaver"
SIMON_EMAIL=simonw21@yahoo.com
SIMON_PASSWORD=password

DAVE_NAME="Dave Filer"
DAVE_EMAIL=david_filer@hotmail.com
DAVE_PASSWORD=password

JOHN_NAME="John Harris"
JOHN_EMAIL=johnrharris174@fastmail.com
JOHN_PASSWORD=password

# An example club member, useful in development. Remove for a live site.
MEMBER_NAME="Club Member"
MEMBER_EMAIL=member@coventrychessclub.test
MEMBER_PASSWORD=password
